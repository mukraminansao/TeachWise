{
  "name": "teachwise",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:web": "expo export -p web",
    "check:release": "node scripts/check-release.cjs",
    "eas-build-post-install": "node scripts/check-release.cjs --android --eas",
    "build:web:release": "node scripts/check-release.cjs && expo export -p web",
    "build:android": "node scripts/check-release.cjs --android && eas build -p android --profile production",
    "build:apk": "node scripts/check-release.cjs --android && eas build -p android --profile preview"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": ">=0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "^11.0.9"
    }
  }
}
